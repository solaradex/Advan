{
  "name": "advan-mcp",
  "version": "0.1.0",
  "description": "Advan — non-custodial Solana trading tools for AI agents (MCP and HTTP).",
  "mcpName": "io.github.solaradex/advan",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solaradex/Advan.git"
  },
  "homepage": "https://github.com/solaradex/Advan",
  "bugs": {
    "url": "https://github.com/solaradex/Advan/issues"
  },
  "keywords": [
    "mcp",
    "solana",
    "jupiter",
    "x402",
    "ai-agents",
    "trading"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "advan-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "start": "node dist/index.js",
    "start:http": "node dist/http-entry.js",
    "dev:http": "tsx src/http-entry.ts",
    "setup:referral": "tsx scripts/setup-referral.ts",
    "claim:referral": "tsx scripts/claim-referral.ts",
    "setup:payto-ata": "tsx scripts/setup-payto-ata.ts",
    "e2e:devnet": "tsx scripts/e2e-devnet-x402.ts",
    "smoke:mcp": "tsx scripts/mcp-smoke.ts"
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "1.60.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@payai/facilitator": "2.4.6",
    "@solana/kit": "8.5.0",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/express": "2.28.0",
    "@x402/extensions": "2.28.0",
    "@x402/fetch": "2.28.0",
    "@x402/mcp": "2.28.0",
    "@x402/svm": "2.28.0",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@jup-ag/referral-sdk": "0.3.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "1.98.4",
    "@types/express": "^4.17.21",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
