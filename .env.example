# Advan server configuration. Copy to .env and fill in your own addresses.
# No secret in this file is real. The server never reads SOLANA_KEYPAIR_PATH.

# HTTP server. Default bind is loopback. Set HOST=0.0.0.0 to publish it, and set
# ADVAN_ALLOWED_HOSTS so DNS rebinding protection stays on.
HOST=127.0.0.1
PORT=8787
# Comma-separated Host headers allowed when binding a public interface.
# Leave empty to skip the extra allow-list (localhost protection still applies when HOST is loopback).
ADVAN_ALLOWED_HOSTS=
# Browser origins allowed to call the HTTP API. `*` allows any origin. `off` sends no CORS headers.
CORS_ORIGIN=*

# Solana RPC used for token_risk, wallet_portfolio, and referral-account checks.
# This is NOT the x402 payment RPC. The public RPC is rate-limited.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# mainnet or devnet. Unset infers devnet when the RPC URL contains "devnet".
SOLANA_CLUSTER=
SOLANA_RPC_TIMEOUT_MS=15000

# Jupiter Swap API V2, Tokens V2, and Price V3. All use api.jup.ag (not lite-api).
# Keyless access is 0.5 RPS. A free portal key raises that to 1 RPS.
JUPITER_API_BASE=https://api.jup.ag
JUPITER_API_KEY=
JUPITER_TIMEOUT_MS=20000

# Referral program. Fees are attached only when JUPITER_REFERRAL_ACCOUNT is set.
# Fee range is 50–255 bps. Jupiter keeps 20%, so 50 bps nets 40 bps.
# Create the account with: npm run setup:referral
JUPITER_REFERRAL_ACCOUNT=
JUPITER_REFERRAL_FEE_BPS=50
# Token accounts that receive fees. SOL means the wSOL mint.
# USDC/USDT here are the mainnet mints. Jupiter drops the fee if feeMint has no account.
JUPITER_REFERRAL_TOKEN_ACCOUNT_SOL=
JUPITER_REFERRAL_TOKEN_ACCOUNT_WSOL=
JUPITER_REFERRAL_TOKEN_ACCOUNT_USDC=
JUPITER_REFERRAL_TOKEN_ACCOUNT_USDT=
# JSON object of additional mint -> referral token account.
JUPITER_REFERRAL_TOKEN_ACCOUNTS=
# Refuse to boot unless the referral account and wSOL/USDC/USDT token accounts are set.
JUPITER_REFERRAL_REQUIRED=false
# fail: withhold the quote/tx when the fee assertion fails. warn: return it with feeCheck.ok false.
FEE_CHECK_MODE=fail
# requote (default): if feeMint has no usable referral token account, quote again without a referral and log it.
# fail: refuse the swap. warn: return the original order with feeCheck.ok false.
REFERRAL_MISSING_MINT_MODE=requote

# Trade guards. Enforced before a quote or transaction is returned.
# Response slippage is also checked, because Jupiter's RTSE picks slippage when the client omits it.
MAX_SLIPPAGE_BPS=300
# Default 1000 when unset. Set off (or 0) to disable the USD cap. Startup warns if both caps are off.
MAX_TRADE_USD=1000
# Base units of the input mint. Unset means only the USD cap applies.
MAX_INPUT_AMOUNT=
MAX_PRICE_IMPACT_PCT=5

# build_swap_tx default. false keeps JupiterZ and tells the client to use POST /swap/v2/execute.
# true excludes jupiterz so the taker can broadcast the signed transaction.
SWAP_SELF_BROADCAST_DEFAULT=false

# RugCheck summary (no key). A timeout is recorded and the score continues.
RUGCHECK_BASE_URL=https://api.rugcheck.xyz
RUGCHECK_TIMEOUT_MS=4000

# x402 exact payments for token_risk and wallet_portfolio.
# get_quote and build_swap_tx stay free.
# Default network is Solana devnet. Mainnet CAIP-2: solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp
X402_PAY_TO=
X402_PRICE_USD=0.01
X402_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
# RPC used only to put a recent blockhash in x402 payment terms.
# Unset derives https://api.devnet.solana.com or https://api.mainnet-beta.solana.com from X402_NETWORK.
# Never falls back to SOLANA_RPC_URL. A mainnet blockhash on a devnet payment makes every paid call fail.
X402_RPC_URL=
# warn: log and continue when price < X402_MIN_FEE_MULTIPLE * facilitator fee. refuse: exit.
X402_PRICE_GUARD=warn
X402_MIN_FEE_MULTIPLE=5
# CDP charges $0.001 after the free 1,000 settlements / month. PayAI mainnet exact is $0.00133; devnet is $0.
X402_CDP_SETTLEMENT_FEE_USD=0.001
X402_PAYAI_SETTLEMENT_FEE_USD=
X402_FACILITATOR_TIMEOUT_MS=90000
# Exit instead of serving free tools when the facilitator probe fails.
X402_REQUIRED=false

# Coinbase CDP facilitator (primary when both are set). PayAI is the fallback and needs no key to start.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Optional. PayAI reads these after the free credit allowance is exhausted.
PAYAI_API_KEY_ID=
PAYAI_API_KEY_SECRET=

# Usage log. /stats reads this file. stdout mirroring is for the HTTP server only.
USAGE_LOG_PATH=./logs/usage.jsonl
USAGE_LOG_STDOUT=false

# Scripts only. The server prints a warning and does not load this file.
SOLANA_KEYPAIR_PATH=
# Referral setup / claim / USDC ATA setup. Public keys, not secret keys.
REFERRAL_PAYER_PUBKEY=
REFERRAL_PARTNER_PUBKEY=
REFERRAL_NAME=
REFERRAL_MINTS=
# e2e client. X402_CLIENT_RPC_URL is the buyer's Solana RPC for building the USDC transfer.
# It is not read by the server. Public devnet RPC is often unreachable.
ADVAN_HTTP_URL=http://127.0.0.1:8787
X402_CLIENT_RPC_URL=https://api.devnet.solana.com
E2E_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
